{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PermitirCloudFront",
      "Effect": "Allow",
      "Principal": { "Service": "cloudfront.amazonaws.com" },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::rumbo-iathon-web-000000000000/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::000000000000:distribution/DISTRIBUTION_ID"
        }
      }
    }
  ]
}
